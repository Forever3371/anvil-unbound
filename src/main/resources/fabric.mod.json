{
  "schemaVersion": 1,
  "id": "anvil_unbound",
  "version": "${version}",
  "name": "Anvil Unbound",
  "description": "铁砧改造：解除合并等级上限（锋利 V + 锋利 V = 锋利 VI，最高可到配置的 1000）、解除大部分附魔互斥（保留靴子与三叉戟两组），并把经验花费改成消耗一颗下界之星，铁砧界面新增专用槽位。",
  "authors": [
    "forever3371"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.example.anvilunbound.AnvilUnbound"
    ],
    "client": [
      "com.example.anvilunbound.AnvilUnboundClient"
    ]
  },
  "mixins": [
    "anvil_unbound.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
